# Neon (written by `neon deploy` / `neon env pull`):
# DATABASE_URL = pooled connection (used by the app)
# DATABASE_URL_UNPOOLED = direct connection (used by Prisma migrations)
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Better Auth
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Development only: shows the dev-login wrench icon in the navbar (ignored in production builds).
DEV_LOGIN="false"
